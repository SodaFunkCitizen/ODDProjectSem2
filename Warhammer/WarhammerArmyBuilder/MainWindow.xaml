<Window x:Class="WarhammerArmyBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarhammerArmyBuilder"
        xmlns:vm="clr-namespace:WarhammerArmyBuilder.ViewModels"
        mc:Ignorable="d"
        Title="40K Army Builder"
        Height="800"
        Width="1200"
        Background="#0f0f14">
    <Window.DataContext>
        <vm:ArmyViewModel/>
    </Window.DataContext>
    <Window.Resources>
            <SolidColorBrush x:Key="PanelBrush" Color="#1a1a22"/>
            <SolidColorBrush x:Key="CardBrush" Color="#242433"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#00FF88"/>
            <SolidColorBrush x:Key="SubTextBrush" Color="#AAAAAA"/>

            <Style x:Key="HeaderText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333344"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333344"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333344"/>
                <Setter Property="Padding" Value="6,4"/>
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="UnitListTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BattlefieldRole}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                           Text="{Binding Points}"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SavedArmyTemplate">
                <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Faction}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding LastModifiedUtc, StringFormat=Last saved: {0:G}}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="TemplateListTemplate">
                <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BattlefieldRole}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Window.Resources>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
            Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Width="44" Height="44" Margin="0,0,12,0"
                       Source="Assets/black_templars.png"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Army.Faction}" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding Army.Name}" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TotalPoints}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Army.LastModifiedUtc, StringFormat=Updated: {0:G}}"
                               Foreground="{StaticResource SubTextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="10">
                <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Army Builder">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                Background="{StaticResource PanelBrush}"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,10,0">
                                <DockPanel>
                                    <TextBlock Text="UNITS" Style="{StaticResource HeaderText}"
                                           DockPanel.Dock="Top" Margin="0,0,0,10"/>

                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBox Text="{Binding UnitSearch, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search by name/role/keywords"
                                             Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding UnitRoles}"
                                                  SelectedItem="{Binding UnitRoleFilter}"/>
                                            <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding UnitSortOptions}"
                                                  SelectedItem="{Binding UnitSort}"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                        <Button Content="+ Add Unit" Click="AddUnit_Click" Margin="0,0,8,0"/>
                                        <Button Content="Remove" Click="RemoveUnit_Click"/>
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding UnitsView}"
                                         SelectedItem="{Binding SelectedUnit}"
                                         ItemTemplate="{StaticResource UnitListTemplate}"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1"
                                Background="{StaticResource PanelBrush}"
                                CornerRadius="8"
                                Padding="15">
                                <ScrollViewer>
                                    <StackPanel DataContext="{Binding SelectedUnit}">
                                        <TextBlock Text="Unit Details" Style="{StaticResource HeaderText}" Margin="0,0,0,10"/>

                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding BattlefieldRole}" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Keywords}" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <TextBlock Text="Notes" Foreground="White" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

                                        <TextBlock Text="Created" Foreground="White" FontWeight="Bold" Margin="0,10,0,6"/>
                                        <TextBlock Text="{Binding CreatedAtUtc, StringFormat={}{0:G} (UTC)}" Foreground="{StaticResource SubTextBrush}"/>

                                        <TextBlock Text="Points" Foreground="White" FontWeight="Bold" Margin="0,10,0,6"/>
                                        <TextBox Text="{Binding Points, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Saved Armies">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Button Content="Refresh" Click="RefreshSaved_Click" Margin="0,0,8,0"/>
                                <Button Content="Save Current" Click="SaveDb_Click" Margin="0,0,8,0"/>
                                <Button Content="Load Selected" Click="LoadDb_Click" Margin="0,0,8,0"/>
                                <Button Content="Delete Selected" Click="DeleteDb_Click"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="SavedArmiesList"
                                     Grid.Column="0"
                                     ItemsSource="{Binding SavedArmies}"
                                     ItemTemplate="{StaticResource SavedArmyTemplate}"
                                     Margin="0,0,10,0"/>

                                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Database notes" Style="{StaticResource HeaderText}" Margin="0,0,0,10"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}">
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>


                    <TabItem Header="Catalogue">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="CatalogueSourceText" Grid.Column="0"
                                     ToolTip="Paste a .cat URL (raw) or leave blank to use embedded sample" />

                                <Button Grid.Column="2" Content="Load from URL" Click="LoadCatalogueUrl_Click" />
                                <Button Grid.Column="4" Content="Load from File" Click="LoadCatalogueFile_Click" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <ListBox Grid.Column="0"
                                     ItemsSource="{Binding CatalogueUnits}"
                                     SelectedItem="{Binding SelectedTemplate}"
                                     ItemTemplate="{StaticResource TemplateListTemplate}"
                                     Margin="0,0,10,0"/>

                                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="15">
                                    <ScrollViewer>
                                        <StackPanel DataContext="{Binding SelectedTemplate}">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Keywords}" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                            <TextBlock Text="Statline" Foreground="White" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Statline}" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                            <TextBlock Text="Abilities" Foreground="White" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Abilities}" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="10"
                Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Validate" Click="Validate_Click" Margin="0,0,8,0"/>
                    <Button Content="Export JSON" Click="Export_Click" Margin="0,0,8,0"/>
                    <Button Content="Import JSON" Click="Import_Click"/>
                </StackPanel>
            </Border>
        </Grid>
</Window>