<Window x:Class="ArmyBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="40K Army Builder"
        Height="800"
        Width="1200"
        Background="#0f0f14">

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#1a1a22"/>
        <SolidColorBrush x:Key="CardBrush" Color="#242433"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00FF88"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#AAAAAA"/>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ADEPTUS ASTARTES"
                               Style="{StaticResource HeaderText}"/>
                    <TextBlock Text="Gladius Task Force"
                               Foreground="{StaticResource SubTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">

                    <TextBlock Text="{Binding TotalPoints}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,10,0">

            <DockPanel>

                <TextBlock Text="UNITS"
                           Style="{StaticResource HeaderText}"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,10"/>

                <Button Content="+ Add Unit"
                        Click="AddUnit_Click"
                        DockPanel.Dock="Bottom"
                        Margin="0,10,0,0"
                        Padding="6"/>

                <ListBox x:Name="UnitList"
                         ItemsSource="{Binding Units}"
                         SelectedItem="{Binding SelectedUnit}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding BattlefieldRole}"
                                               Foreground="{StaticResource SubTextBrush}"
                                               FontSize="12"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Points}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>
        </Border>
        
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="15">

            <ScrollViewer>

                <StackPanel DataContext="{Binding SelectedUnit}">

                    <TextBlock Text="Unit Details"
                               Style="{StaticResource HeaderText}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding Keywords}"
                               Foreground="{StaticResource SubTextBrush}"
                               Margin="0,0,0,10"/>

                </StackPanel>

            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="10"
                Margin="0,10,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Validate"
                        Click="Validate_Click"
                        Margin="5,0"
                        Padding="8,4"/>

                <Button Content="Export"
                        Click="Export_Click"
                        Padding="8,4"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
    
    